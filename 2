class Monster:
    def __init__(self,name,hp,dmg):
        self.name = name
        self.hp = hp
        self.dmg = dmg

    def take_damage(self,damage):
        self.hp -= damage
        print(f'{self.name} получает:{damage}. HP: {self.hp}')

    def attack_hunter(self,hunter):
        hunter.hp -= self.dmg

class Zombie(Monster):
    def __init__(self, name):
        super().__init__(name,120,10)

    def take_damage(self,damage):
        actual_damahe = damage - 5
        self.hp -= actual_damahe
        print(f'{self.name} поглозает 5 урона! Получено: {take_damage}.HP: {self.hp}')

class Vampire(Monster):
    def __init__(self, name):
        super().__init__(name,80,15)

        def take_damage(self,damage):
            actual_damahe = damage - 5
            self.hp -= actual_damahe
            print(f'{self.name} поглощает 5 урона! Получино {take_damage}.HP: {self.hp}')

