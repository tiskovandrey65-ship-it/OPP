class Monster:
    def __init__(self,name,hp,dmg):
        self.name = name
        self.hp = hp
        self.dmg = dmg


    def take_damage(self,damage):
        self.hp -= damage
        print(f'{self.name} получает:{damage}. HP: {self.hp}')

    def attack_hunter(self,hunter):
        hunter.hp -= self.dmg

class Zombie(Monster):
    def __init__(self, name):
        super().__init__(name,120,10)

    def take_damage(self,damage):
        self.hp -= damage
        print(f'{self.name} теряет конечность. Получено: {damage}. HP: {self.hp}')

class Vampire(Monster):
    def __init__(self, name):
        super().__init__(name,80,15)

    def take_damage(self,damage):
        actual_damage = damage - 5
        self.hp -= actual_damage
        print(f'{self.name} поглощает 5 урона! Получено {actual_damage}.HP: {self.hp}')

class Ghost(Monster):
    def __init__(self, name):
        super().__init__(name,60, 15)

        def take_damage(self,damage):
            import random

            if random.random() < 0.3:
                print(f'{self.name} уклонился!')
            else:
                self.hp -= damage
                print(f'{self.name}получил:{damage}. HP: {self.hp}')

class Werewolf(Monster):
    def __init__(self, name):
        super().__init__(name,100,25)

    def take_damage(self,damage):
        self.hp -= damage
        print(f'{self.name} получил {damage}. HP: {self.hp} ')

        if self.hp < 50:
            print(f"{self.name} трансформируется")

v = Vampire('Дракула')
v.take_damage(30)

z = Zombie('Зомби')
z.take_damage(30)

